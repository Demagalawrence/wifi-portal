generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String        @id @default(uuid())
  username          String        @unique
  passwordHash      String
  role              String        @default("user")
  email             String?
  phone_number      String?
  is_active_session Boolean       @default(false)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  payments          Payment[]
  sessions          Session[]
  accessTokens      AccessToken[]
}

model Plan {
  id               String        @id
  name             String
  description      String        @default("")
  price            Float
  duration_hours   Int
  duration_display String
  features         String        @default("[]") // JSON string of features
  is_active        Boolean       @default(true)
  sort_order       Int           @default(0)
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  payments         Payment[]
  sessions         Session[]
  accessTokens     AccessToken[]
}

model Payment {
  id                 String        @id @default(uuid())
  user_id            String
  plan_id            String
  amount             Float
  payment_method     String
  phone_number       String
  transaction_id     String?
  status             String        @default("pending")
  external_reference String?
  failure_reason     String?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  user               User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan               Plan          @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  sessions           Session[]
  accessTokens       AccessToken[]
}

model Session {
  id            String        @id @default(uuid())
  user_id       String
  plan_id       String
  payment_id    String
  mac_address   String?
  ip_address    String?
  status        String        @default("active")
  start_time    DateTime      @default(now())
  end_time      DateTime
  data_used     Float         @default(0)
  last_activity DateTime      @default(now())
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan          Plan          @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  payment       Payment       @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  accessTokens  AccessToken[]
}

model AccessToken {
  id               String      @id @default(uuid())
  code             String      @unique
  user_id          String
  plan_id          String
  payment_id       String
  session_id       String?
  phone_number     String
  mac_address      String?
  status           String      @default("active")
  expires_at       DateTime
  regenerated_from String?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  user             User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  plan             Plan        @relation(fields: [plan_id], references: [id], onDelete: Cascade)
  payment          Payment     @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  session          Session?    @relation(fields: [session_id], references: [id], onDelete: SetNull)
}
